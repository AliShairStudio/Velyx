<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="300dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/chat_sent_bg"
        app:strokeWidth="0.5dp"
        app:strokeColor="#BBD6FB">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvForwarded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/glass_tag_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Forwarded"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bottom_gradient_shadow" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPinned"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/pin"
                    app:tint="@color/white"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivStarred"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/star"
                    app:tint="#FFD700"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/ivStatus"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_tick_double"
                    app:tint="@color/status_blue"
                    android:alpha="0.9" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutReactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/white_curved_bg"
        android:elevation="3dp"
        android:padding="2dp"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />
</LinearLayout>
