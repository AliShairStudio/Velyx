<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPermissions"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_color"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="App Permissions"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnOpenSettingsCard"
        app:layout_constraintTop_toBottomOf="@id/toolbarPermissions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Access"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- Microphone (Rounded Top) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/option_card_bg"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/RoundedTop">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_btn_speak_now"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Microphone"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location (Middle) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/option_card_bg"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/RectangularSmall">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Location"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swLoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SMS (Middle) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/option_card_bg"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/RectangularSmall">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/sym_action_chat"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SMS"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera (Middle) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/option_card_bg"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/RectangularSmall">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Camera"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swCam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notifications (Rounded Bottom) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/option_card_bg"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/RoundedBottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notifications"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swNotif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:trackTint="@color/switch_track_color"
                        app:thumbTint="@color/switch_thumb_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnOpenSettingsCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary_blue"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN SYSTEM SETTINGS"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
