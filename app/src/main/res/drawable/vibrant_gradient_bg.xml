<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Gradient (Red to Purple to Blue) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF416C"
                android:centerColor="#6A11CB"
                android:endColor="#2575FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Second layer to add Orange and Teal highlights -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#60FF4B2B"
                android:centerColor="#00000000"
                android:endColor="#6000FF88"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
